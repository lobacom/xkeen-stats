#!/opt/bin/sh
ENABLED=yes
PROCS=xkeen-stats
ARGS="-listen 192.168.1.1:1001 -state /opt/var/lib/xkeen-stats/state.json"
PREARGS=""
DESC="$PROCS"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export GOMEMLIMIT=24MiB
export GOGC=100
umask 077
case "$1" in
  start|restart|reconfigure)
    if test -x /opt/var/lib/xkeen-stats/update/updater; then
      /opt/var/lib/xkeen-stats/update/updater -recover-update || exit 1
    fi
    /opt/sbin/xkeen-stats -prepare-auth || exit 1
    /opt/etc/ndm/netfilter.d/051-xkeen-stats-lan.sh || exit 1
    /opt/sbin/xkeen-stats -check-access >/dev/null 2>&1 || exit 1
    ;;
esac
. /opt/etc/init.d/rc.func
